# ---- Python bytecode / build caches ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Packaging / build metadata ----
*.egg-info/
*.egg-link
.eggs/
build/
*.egg

# ---- Test & tool caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Release artifacts ----
# NOTE: the wheel/sdist files currently committed under dist/ are intentionally
# shipped release artifacts for this repo (see git history, e.g.
# "0.1.5: PyPI republish ..."). They are therefore NOT ignored. Uncomment the
# line below only if that policy changes.
# dist/

# ---- Editor / OS junk ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ---- CI build output ----
# The release workflows build with `--outdir dist-upload` so the uploaded artifact is
# exactly what the commit produced (dist/ holds historical releases on purpose). This
# directory is output, not source: a local `python -m build --outdir dist-upload` put a
# 1.2 MB wheel into the index once already.
dist-upload/

# Scratch space for the verification tools when the system temp directory is not writable.
.phoc-scratch/

# Scratch space for the verification tools (system temp may be unwritable).
.phocinae-verify/
.phoc-scratch/
